{
  "name": "pi-web-agent",
  "version": "1.0.0",
  "description": "Pi coding agent as a web/desktop app (Codex-style UI), powered by pi --mode rpc",
  "type": "module",
  "main": "server.js",
  "bin": {
    "pi-web-agent": "server.js"
  },
  "scripts": {
